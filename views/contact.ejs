<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Beyond the Pyramids</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/public.css">
    <link rel="stylesheet" href="/css/contact.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="info-page">
    <div class="noise-overlay"></div>

    <nav class="navbar" id="main-nav">
        <div class="nav-container">
            <div class="logo">
                <a href="/"><img src="/images/WebsiteBanner.png" alt="Beyond the Pyramids Logo"></a>
            </div>
            <ul class="nav-menu">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/packages/day" class="nav-link">Day Packages</a></li>
                <li><a href="/packages/week" class="nav-link">Week Packages</a></li>
                <li><a href="/packages/single" class="nav-link">Single Locations</a></li>
                <li><a href="/custom-trip" class="nav-link">Custom Trip</a></li>
                <li id="nav-dashboard-link" <% if (!user) { %>style="display:none"<% } %>>
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                </li>
            </ul>
            <div class="nav-actions">
                <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                    <i class="fas fa-sun sun-icon"></i>
                    <i class="fas fa-moon moon-icon"></i>
                </button>
                <div class="nav-buttons">
                    <% if (user) { %>
                    <a href="/dashboard" class="btn btn--outline"><i class="fas fa-user"></i> <%= user.name.split(' ')[0] %></a>
                    <a href="#" id="logout-btn" class="btn btn--primary">Logout</a>
                    <% } else { %>
                    <a href="/login" class="btn btn--outline">Log In</a>
                    <a href="/register" class="btn btn--primary">Sign Up</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="page-title reveal-up">
        <h1 class="hero-title">Get in <span class="text-gold">Touch</span></h1>
        <p class="hero-description">Begin your journey beyond the pyramids with a conversation.</p>
    </div>

    <main class="main-container">
        <div class="contact-grid">

            <div class="contact-details reveal-up">
                <div class="details-section">
                    <h2 class="section-display-title">Concierge <span class="text-gold">Information</span></h2>
                    <p class="section-desc">Our dedicated team is ready to curate your Egyptian legacy. Reach out to us through any of our channels.</p>
                </div>

                <div class="info-grid">
                    <div class="info-card glass-card">
                        <i class="fas fa-map-marker-alt"></i>
                        <div class="info-text">
                            <h4>Legacy Office</h4>
                            <p>123 Nile Heritage Street, Cairo, Egypt</p>
                        </div>
                    </div>
                    <div class="info-card glass-card">
                        <i class="fas fa-phone-alt"></i>
                        <div class="info-text">
                            <h4>Direct Concierge</h4>
                            <p>+20 123 456 7890</p>
                        </div>
                    </div>
                    <div class="info-card glass-card">
                        <i class="fas fa-envelope"></i>
                        <div class="info-text">
                            <h4>Inquiries</h4>
                            <p>concierge@beyondpyramids.com</p>
                        </div>
                    </div>
                </div>

                <div class="map-wrapper reveal-up">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d110502.60385038!2d31.1882508!3d30.0594885!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14583fa60b21beeb%3A0x79dfb296efaaad!2sCairo%2C%20Cairo%20Governorate!5e0!3m2!1sen!2seg!4v1700000000000!5m2!1sen!2seg"
                        width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy">
                    </iframe>
                </div>
            </div>

            <div class="contact-form-container reveal-up">
                <div class="glass-card contact-form-card">
                    <h2>Send a <span class="text-gold">Message</span></h2>
                    <p>Have a specific vision or question? We respond within 24 hours.</p>

                    <form id="contact-form" class="heritage-form">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="name">Full Name</label>
                                <input type="text" id="name" placeholder="E.g. Alexander Great" required value="<%= user ? user.name : '' %>" <% if (user) { %>readonly class="field-locked"<% } %>>
                            </div>
                            <div class="form-group">
                                <label for="email">Email Address</label>
                                <input type="email" id="email" placeholder="alex@heritage.com" required value="<%= user ? user.email : '' %>" <% if (user) { %>readonly class="field-locked"<% } %>>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="subject">Inquiry Subject</label>
                            <input type="text" id="subject" placeholder="E.g. Custom Luxor Tour" required>
                        </div>

                        <div class="form-group">
                            <label for="message">Detailed Message</label>
                            <textarea id="message" rows="5" placeholder="Share your travel aspirations with us..." required></textarea>
                        </div>

                        <div id="contact-error" style="display:none;color:var(--color-danger);margin-bottom:1rem;"></div>
                        <div id="contact-success" style="display:none;color:var(--color-success);margin-bottom:1rem;"></div>

                        <button type="submit" class="btn btn--primary btn--full btn--large">Dispatch Inquiry</button>
                    </form>
                </div>
            </div>

        </div>
    </main>

    <% if (user) { %>
    <section class="main-container" style="padding-top:0;">
        <div class="glass-card reveal-up" style="padding:2rem;">
            <h2 style="margin-bottom:0.25rem;">Your <span class="text-gold">Inquiries</span></h2>
            <p style="opacity:0.7;margin-bottom:1.5rem;">Track the status of messages you've sent us.</p>
            <div id="my-tickets-container"><p style="opacity:0.6;">Loading your inquiries...</p></div>
        </div>
    </section>
    <% } %>

    <footer class="main-footer reveal-up">
        <div class="container footer-grid">
            <div class="footer-brand">
                <h3 class="footer-logo">Beyond the Pyramids</h3>
                <p>Curating the eternal legacy of Egypt since 2012.</p>
            </div>
            <nav class="footer-nav">
                <div class="footer-group">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/#destinations">Destinations</a></li>
                        <li><a href="/#packages">Tour Packages</a></li>
                        <li><a href="/custom-trip">Custom Trips</a></li>
                    </ul>
                </div>
                <div class="footer-group">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/about">Our Story</a></li>
                        <li><a href="/faq">Common Questions</a></li>
                    </ul>
                </div>
                <div class="footer-group">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/terms">Terms of Service</a></li>
                    </ul>
                </div>
            </nav>
            <div class="footer-newsletter">
                <h4>Join the Inner Circle</h4>
                <p>Receive exclusive travel insights and early access to new tours.</p>
                <form class="newsletter-form">
                    <input type="email" placeholder="Your email address" required>
                    <button type="submit" class="btn btn--primary">Join</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom container">
            <p>&copy; 2026 Beyond the Pyramids. All rights reserved.</p>
            <div class="credit">Designed for the modern explorer.</div>
        </div>
    </footer>

    <script>
        const SERVER_DATA = { user: <%- JSON.stringify(user) %> };
        window.SERVER_USER = SERVER_DATA.user;
    </script>
    <script src="/js/global.js"></script>
    <script src="/js/contact.js"></script>
</body>

</html>
