<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Forbidden Sanctuary - 403 | Beyond the Pyramids</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/error403.css">
</head>
<body class="error-page-body">
    <div class="noise-overlay"></div>

    <main class="error-wrapper">
        <div class="sanctuary-bg"></div>

        <div class="error-content reveal-up">
            <div class="glass-card error-card">
                <div class="error-header">
                    <span class="error-code">403</span>
                    <h1 class="hero-title">A Forbidden Sanctuary</h1>
                </div>

                <p class="error-description">
                    The path to this chamber is sealed. Only those with the sacred credentials may pass through these gates. If you believe this is an error, please consult your guide or verify your access.
                </p>

                <% if (typeof message !== 'undefined' && message) { %>
                <p style="color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1rem;"><%= message %></p>
                <% } %>

                <div class="error-actions">
                    <a href="/login" class="btn-gold">Present Credentials</a>
                    <a href="/" class="btn-outline">Return to Home</a>
                </div>

                <div class="error-footer">
                    <span class="hieroglyphs">𓉐 𓋴 𓉐</span>
                    <p>Experience the eternal legacy of Egypt.</p>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/global.js"></script>
</body>
</html>
