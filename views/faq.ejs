<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAQ - Beyond the Pyramids</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/public.css">
    <link rel="stylesheet" href="/css/faq.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="info-page">
    <div class="noise-overlay"></div>

    <nav class="navbar" id="main-nav">
        <div class="nav-container">
            <div class="logo">
                <a href="/"><img src="/images/WebsiteBanner.png" alt="Beyond the Pyramids Logo"></a>
            </div>
            <ul class="nav-menu">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/packages/day" class="nav-link">Day Packages</a></li>
                <li><a href="/packages/week" class="nav-link">Week Packages</a></li>
                <li><a href="/packages/single" class="nav-link">Single Locations</a></li>
                <li><a href="/custom-trip" class="nav-link">Custom Trip</a></li>
                <li id="nav-dashboard-link" <% if (!user) { %>style="display:none"<% } %>>
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                </li>
            </ul>
            <div class="nav-actions">
                <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                    <i class="fas fa-sun sun-icon"></i>
                    <i class="fas fa-moon moon-icon"></i>
                </button>
                <div class="nav-buttons">
                    <% if (user) { %>
                    <a href="/dashboard" class="btn btn--outline"><i class="fas fa-user"></i> <%= user.name.split(' ')[0] %></a>
                    <a href="#" id="logout-btn" class="btn btn--primary">Logout</a>
                    <% } else { %>
                    <a href="/login" class="btn btn--outline">Log In</a>
                    <a href="/register" class="btn btn--primary">Sign Up</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="page-title reveal-up">
        <h1 class="hero-title">Common <span class="text-gold">Questions</span></h1>
        <p class="hero-description">Detailed guidance for the modern explorer in Egypt</p>
    </div>

    <div class="main-container">

        <div class="category-tabs reveal-up">
            <button class="tab-btn" data-category="general">General</button>
            <button class="tab-btn" data-category="booking">Booking & Payment</button>
            <button class="tab-btn" data-category="trips">Trips & Packages</button>
            <button class="tab-btn" data-category="account">Account & Profile</button>
            <button class="tab-btn" data-category="cancel">Cancellation & Refunds</button>
            <button class="tab-btn" data-category="support">Support & Contact</button>
        </div>

        <div id="faqContainer" class="faq-container reveal-up">
        </div>

        <div class="contact-box glass-card reveal-up">
            <div class="contact-box-content">
                <h3>Still have questions?</h3>
                <p>Our concierge team is available 24/7 to assist with your journey.</p>
            </div>
            <a href="/contact" class="btn btn--gold">Contact Concierge</a>
        </div>

    </div>

    <footer class="main-footer reveal-up">
        <div class="container footer-grid">
            <div class="footer-brand">
                <h3 class="footer-logo">Beyond the Pyramids</h3>
                <p>Curating the eternal legacy of Egypt since 2012.</p>
            </div>
            <nav class="footer-nav">
                <div class="footer-group">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/#destinations">Destinations</a></li>
                        <li><a href="/#packages">Tour Packages</a></li>
                        <li><a href="/custom-trip">Custom Trips</a></li>
                    </ul>
                </div>
                <div class="footer-group">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/about">Our Story</a></li>
                        <li><a href="/faq">Common Questions</a></li>
                    </ul>
                </div>
                <div class="footer-group">
                    <h4>Legal</h4>
                    <ul>
                        <li><a href="/terms">Terms of Service</a></li>
                    </ul>
                </div>
            </nav>
        </div>
        <div class="footer-bottom container">
            <p>&copy; 2026 Beyond the Pyramids. All rights reserved.</p>
            <div class="credit">Designed for the modern explorer.</div>
        </div>
    </footer>

    <script>
        const SERVER_DATA = { user: <%- JSON.stringify(user) %> };
        window.SERVER_USER = SERVER_DATA.user;
</script>
    <script src="/js/faq.js"></script>
    <script src="/js/global.js"></script>
</body>

</html>
