NODE_ENV=production
PORT=3000

# MongoDB Atlas free tier: https://www.mongodb.com/cloud/atlas/register
MONGO_URL=your_mongodb_atlas_connection_string

JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=7d

# Free key: https://openweathermap.org/api (takes up to 2 hours to activate)
OPENWEATHER_API_KEY=your_key_here

# Cloudinary free tier: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional, defaults to 2097152 (2 MB)
MAX_FILE_SIZE=2097152
